# ============================================================
#  ReactFlux Stack — Environment Variables
#  Copy this file to .env and fill in your values.
#
#    cp .env.example .env
#
#  NEVER commit .env to source control.
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────
# Password for the Miniflux database user.
# Change this before first deploy.
POSTGRES_PASSWORD=changeme

# ── Miniflux ──────────────────────────────────────────────
# Admin credentials created on first startup (RUN_MIGRATIONS=1).
# Change these before exposing Miniflux on a public network.
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=changeme

# ── Host ports ────────────────────────────────────────────
# Port the ReactFlux SPA (Caddy) listens on.
# Change if 2000 is already taken on your host.
REACTFLUX_PORT=2000

# Port the Miniflux API/UI listens on.
# Change if 8080 is already taken on your host.
MINIFLUX_PORT=8080

# ── Mercury Proxy (optional) ──────────────────────────────
# Timeout (ms) for full-article extraction requests.
# Raise if you have slow target sites; lower to fail faster.
MERCURY_TIMEOUT_MS=15000
